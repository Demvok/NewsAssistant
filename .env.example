# AI News Intelligence Assistant - Environment Configuration Template
# 
# Copy this file to .env and fill in the values for your environment.
# This file contains SENSITIVE configuration (credentials, URLs, API keys).
#
# Non-sensitive settings are in config.yaml.
# 
# SECURITY: Never commit the actual .env file with real credentials to version control.

# ============================================================================
# DATABASE CONFIGURATION (Sensitive: Credentials)
# ============================================================================
# Database connection URL with username and password
# 
# Examples:
#   MySQL:      mysql+pymysql://user:password@localhost:3306/database_name
#   PostgreSQL: postgresql://user:password@localhost:5432/database_name
#   SQLite:     sqlite:///./data/articles.db
#
# For local development, you can use SQLite:
#   DATABASE_URL=sqlite:///./data/articles.db
DATABASE_URL=""

# ============================================================================
# LM STUDIO CONFIGURATION (Sensitive: API Endpoints)
# ============================================================================

# Base URL for LM Studio API (OpenAI-compatible endpoint)
# 
# Default for local LM Studio: http://localhost:1234/v1
# If LM Studio is running on a different host/port, update accordingly
# Example: http://192.168.1.100:1234/v1
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Chat/generation model name deployed on LM Studio
# 
# This must exactly match the model name loaded in LM Studio
# Common models: gemma-4-e4b, mistral-7b, neural-chat-7b, etc.
CHAT_MODEL=google/gemma-4-e4b

# Embedding model name deployed on LM Studio
# 
# This must exactly match the embedding model name loaded in LM Studio
# Common models: embeddinggemma-300M-GGUF, all-MiniLM-L6-v2, etc.
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m

# Request timeout in seconds for LM Studio API calls
# Increase if you have network latency or slower models
REQUEST_TIMEOUT=60