# AI News Intelligence Assistant Configuration
# Copy this file to .env and adjust values as needed

# ============================================================================
# LM Studio Configuration
# ============================================================================
# Base URL for LM Studio API (OpenAI-compatible endpoint)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Chat/generation model name deployed on LM Studio
CHAT_MODEL=gemma-4-e4b

# Embedding model name deployed on LM Studio
EMBEDDING_MODEL=embeddinggemma-300M-GGUF

# Request timeout in seconds
REQUEST_TIMEOUT=60

# ============================================================================
# Generation Parameters (LLM Decoding Settings)
# ============================================================================
# Temperature for sampling (0.0 = deterministic, higher = more random)
DEFAULT_TEMPERATURE=0.7

# Nucleus sampling parameter (0.0-1.0, how much probability mass to consider)
DEFAULT_TOP_P=0.95

# Top-k sampling parameter (keep top k tokens by probability)
DEFAULT_TOP_K=40

# Maximum tokens to generate per response
MAX_TOKENS=512

# ============================================================================
# RAG Configuration (Document Chunking)
# ============================================================================
# Enable retrieval-augmented generation by default in chat
RAG_ENABLED_DEFAULT=true

# Size of each document chunk (in tokens/characters)
CHUNK_SIZE=512

# Overlap between consecutive chunks (reduce information loss at boundaries)
CHUNK_OVERLAP=50

# ============================================================================
# ChromaDB Configuration (Vector Database)
# ============================================================================
# Distance metric for similarity search: cosine, euclidean, manhattan
CHROMA_DISTANCE_METRIC=cosine

# Number of top chunks to retrieve per query
TOP_K_RETRIEVAL=5

# ============================================================================
# Application Settings
# ============================================================================
# Enable multi-agent reasoning mode by default
MULTI_AGENT_ENABLED_DEFAULT=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Streamlit theme: dark or light
STREAMLIT_THEME=dark
